# Gambit environment variables.
# Copy to .env.local (git-ignored) and fill in. Offline modes (local 1v1 and
# the computer) work with none of these set; accounts and online play need the
# first three. `npm run db:verify` checks them against your project (read-only).

# --- Supabase: public, safe in the browser bundle ---------------------------
# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase: server only, never prefix with NEXT_PUBLIC_ -------------------
# Project Settings → API Keys → Secret key (sb_secret_...). Used only by the
# Next.js API routes to call the service_role database functions.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional ---------------------------------------------------------------
# Seconds an opponent can be gone before "Opponent disconnected" is shown.
NEXT_PUBLIC_DISCONNECT_GRACE_SECONDS=8

# Protects GET /api/maintenance, which settles expired clocks and closes stale
# rooms. Only needed if pg_cron is NOT enabled on your Supabase project and you
# schedule the endpoint from your host (Vercel Cron sends this as a Bearer token).
CRON_SECRET=

# --- Tests only -------------------------------------------------------------
# End-to-end tests (npm run test:e2e) run against an app that is already up.
# Point them at a TEST Supabase project — never production.
E2E_BASE_URL=http://localhost:3000
# Two confirmed accounts created by hand in that test project. Without them the
# two-player tests are skipped; the tests never create or delete accounts.
E2E_USER_A_EMAIL=
E2E_USER_A_PASSWORD=
E2E_USER_B_EMAIL=
E2E_USER_B_PASSWORD=
# Optional: use an installed browser (msedge or chrome) instead of `npx playwright install`.
E2E_CHANNEL=
